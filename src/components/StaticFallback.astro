---
const posterUrl = `${import.meta.env.BASE_URL}bifurcate-poster.png`;
---

<main class="static-fallback">
  <header class="static-fallback__hero">
    <div>
      <p class="eyebrow">MATHEMATICAL MUSIC / DETERMINISTIC AUDIOVISUAL ART</p>
      <h1>BIFURCATE</h1>
      <p class="subtitle">Hearing the Logistic Map</p>
    </div>
    <code>x[n+1] = r · x[n] · (1 − x[n])</code>
  </header>

  <section class="static-fallback__stage" aria-labelledby="static-fallback-title">
    <img
      src={posterUrl}
      alt="A mathematically generated logistic-map bifurcation field from r 2.7 through 4.0."
      width="1600"
      height="1200"
      decoding="async"
    />
    <div class="static-fallback__copy">
      <p class="eyebrow">LOADING THE INTERACTIVE INSTRUMENT</p>
      <h2 id="static-fallback-title">One equation. Many behaviors.</h2>
      <p>
        The interactive version turns canonical logistic-map orbit values into synchronized
        sound and visualization. RAW sonification and the musicalized composition use the
        same deterministic mathematical events.
      </p>
      <div class="static-fallback__facts" aria-label="Canonical composition facts">
        <span>96 BPM</span>
        <span>92 bars</span>
        <span>230 seconds</span>
        <span>736 primary events</span>
      </div>
    </div>
  </section>

  <noscript>
    <p class="static-fallback__noscript">
      JavaScript is disabled. The static artwork above remains mathematically generated,
      but interactive audio, chapter navigation, Math Lens, Explore Mode, and exports require JavaScript.
    </p>
  </noscript>
</main>
